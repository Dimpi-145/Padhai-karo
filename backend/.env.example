# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI provider: "auto" tries local Gemma first, then Gemini.
# Use "gemma" or "gemini" to force a single provider.
AI_PROVIDER=auto

# Local Gemma through Ollama (preferred by "auto").
# Install/start Ollama, then run: ollama pull gemma3:4b
GEMMA_API_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
GEMMA_TIMEOUT_MS=120000

# Server Configuration
PORT=5000

# MongoDB Atlas or local MongoDB connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=studymate

# Generate a unique secret (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Optional: allowed browser origin for production deployments
# FRONTEND_ORIGIN=https://your-frontend.example.com
